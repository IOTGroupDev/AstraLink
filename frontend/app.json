{
  "expo": {
    "name": "AstraLinkTest",
    "slug": "astralink",
    "scheme": "astralink",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0618"
    },
    "ios": {
      "bundleIdentifier": "astralink.test",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "buildNumber": "55",
