# ============================================
# Production Environment Configuration
# Using Supabase for PostgreSQL
# ============================================

# Database (Supabase)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Example: postgresql://postgres.ayoucajwdyinyhamousz:PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Configuration
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
DATA_ENCRYPTION_KEY=replace_with_a_long_random_secret_at_least_32_chars
# Optional JSON array of previous secrets; new writes still use the active key.
DATA_ENCRYPTION_PREVIOUS_KEYS=[]
# Default cutover mode is encrypted-only birth data writes.
# Set to true only for a short legacy dual-write rollback window.
BIRTH_DATA_WRITE_PLAINTEXT=false

# Redis (Local in Docker)
REDIS_PASSWORD=your-strong-redis-password
REDIS_URL=redis://:your-strong-redis-password@redis:6379

# Security
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
NODE_ENV=production

# Server
BACKEND_PORT=3000

# AI Providers (at least one of the three keys is required in production)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...

# Upload/Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# CORS
FRONTEND_URL=https://your-domain.com

# SSL/Domain (for nginx and certbot)
DOMAIN=api.your-domain.com
SSL_EMAIL=admin@your-domain.com

# Deployment routing (same production API as EAS/app config)
EXPO_PUBLIC_API_URL=https://api.astralink.vip
# Set exact browser origins only when deploying a web frontend.
ALLOWED_ORIGINS=https://astralink.vip
TRUST_PROXY="loopback, linklocal, uniquelocal"
# Migrations run as a separate reviewed release step, after schema baseline verification.
SKIP_PRISMA_MIGRATIONS=true
